# Copy to .env.local and fill in.

# Postgres connection. Locally: `npm run db:local init` starts a Postgres cluster on :5434 (see scripts/local-db.mjs).
# On Supabase use the transaction pooler (port 6543) for DATABASE_URL and the session pooler (5432) for DIRECT_URL.
DATABASE_URL=postgresql://postgres@localhost:5434/restaurantina
DIRECT_URL=postgresql://postgres@localhost:5434/restaurantina

# Long random string used to sign admin session cookies (openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-long-random-string

# Initial admin login (created by `npm run db:seed`). Change the password after first sign-in.
ADMIN_EMAIL=owner@restaurantina.local
ADMIN_PASSWORD=change-me
ADMIN_NAME=Owner

# Public site URL, used for SEO metadata + calendar links (Vercel falls back to its production URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3200
